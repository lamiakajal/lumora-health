# Copy this file to .env.local and fill in the values.
# Never commit .env.local.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (MongoDB Atlas) ---
# Include the database name at the end, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lumora
MONGODB_URI=

# --- Auth (Better Auth) ---
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend) ---
# Without RESEND_API_KEY the site still works: emails are only written to the terminal.
RESEND_API_KEY=
EMAIL_FROM="Lumora Health <onboarding@resend.dev>"

# --- Daily reminder job (Vercel Cron) ---
# Any long random text. Vercel sends it with the cron request; without it the job refuses to run.
CRON_SECRET=

# --- Payments / Stripe test mode (added in a later step) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
